GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Required by Census ACS data queries; activate a key from Census.
CENSUS_API_KEY=
# Optional public identifiers for the auth UI; never a Supabase secret key.
SUPABASE_PROJECT_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional identifying User-Agent for NOAA requests.
PUBLIC_DATA_USER_AGENT=GeoCast/1.0 (public disaster-data explorer)
