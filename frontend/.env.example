# Optional FastAPI base URL. Leave unset to use clearly labeled demo data.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional chat backend origin. Leave unset to use the Vite /api proxy.
# VITE_CHAT_API_BASE_URL=http://127.0.0.1:8000

# Arpita authentication: only project URL and publishable key belong in browser config.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional public-data backend prefix (default /api/public).
# VITE_PUBLIC_DATA_API_BASE_URL=/api/public
