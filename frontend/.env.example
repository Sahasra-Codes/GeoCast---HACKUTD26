# Public auth identifiers only. Configure here or use backend/.env as described in the main README.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vite proxies public data and chat to FastAPI on port 8002 by default.
# Override only when hosting the APIs separately.
# VITE_PUBLIC_DATA_API_BASE_URL=/api/public
# VITE_CHAT_API_BASE_URL=http://127.0.0.1:8002

# Gemini and Census keys belong only in server-side .env files, never VITE_* variables.
